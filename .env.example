# .env.local 로 복사해서 값을 채운다 (cp .env.example .env.local). 실제 값은 절대 커밋하지 않는다.

# 네이버 클라우드 플랫폼 > Maps > Application > 인증 정보
# 지도 허용 URL(Web 서비스 URL)에 http://localhost:3000 이 등록되어 있어야 지도가 뜬다.
NEXT_PUBLIC_NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=

# 네이버 클라우드 플랫폼 > NAVER API HUB > Application > 인증 정보 (지역 검색)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# SK open API > TMAP > 앱 > App Key (보행자 경로, 하루 1,000건 무료)
TMAP_APP_KEY=

# Supabase > Project Settings > API (secret 키는 서버에서만 쓴다)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 화면(/admin) 비밀 키, 매일 도는 도보 시간 재계산(Vercel Cron) 인증 키 — 아무 긴 무작위 문자열
ADMIN_SECRET=
CRON_SECRET=
